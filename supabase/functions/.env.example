# Edge Function secrets for the LOCAL stack: `supabase functions serve`
# reads supabase/functions/.env, which is gitignored. Copy this file to
# `.env` next to it and fill in the keys you have. Never commit `.env`.
#
# On a hosted project the same names are set as Edge Function secrets:
#   supabase secrets set ANTHROPIC_API_KEY=... (from your own terminal)
#
# Every key is optional. An engine whose key is missing reports
# `unavailable` for its answers instead of failing the run, and the
# sentiment judge falls back to a keyless mock judge (labelled as such).

# ---- Judge + Claude engine (Anthropic) -------------------------------------
# Used by the sentiment judge (every answer is judged) and by the Claude
# answer engine. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: the Claude engine's model (default claude-sonnet-5-5).
ANTHROPIC_MODEL=
# Optional: web searches the Claude engine may run per answer (default 5).
# Search results count as input tokens, so this is the cost lever.
ANTHROPIC_MAX_SEARCHES=
# Optional: basic | dynamic (default basic). The dynamic tool filters results
# with code execution and costs roughly 2.5x more input tokens per answer.
ANTHROPIC_SEARCH_TOOL=
# Optional: the fallback judge model (default claude-sonnet-5-5; any key in
# MODEL_REGISTRY, _shared/llm.ts, Anthropic or OpenAI).
JUDGE_MODEL=

# ---- ChatGPT engine (OpenAI Responses API + web search) --------------------
# Get one at platform.openai.com. A "restricted" key with only model
# capabilities is enough.
OPENAI_API_KEY=
# Optional: default gpt-5.2.
OPENAI_MODEL=

# ---- Gemini engine (Gemini API + Google Search grounding) ------------------
# Get one at aistudio.google.com. Grounded search needs billing enabled on
# the project; the free tier has no quota for it.
GEMINI_API_KEY=
# Optional: default gemini-3.8-flash.
GEMINI_MODEL=

# ---- Google AI Overview engine ----------------------------------------------
# Default adapter: DataForSEO's Google Organic SERP API (Basic auth; the
# login and password from app.dataforseo.com, pay as you go).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Alternate adapter: SerpAPI. Set GOOGLE_ADAPTER=serpapi to use it.
SERPAPI_KEY=
GOOGLE_ADAPTER=

# ---- Who may spend the keys, and how much ----------------------------------
# Optional but recommended on a hosted project: only these accounts may run
# prompts or judgments (comma-separated, case-insensitive). Unset = anyone
# who can sign in, so pair "unset" with sign-ups switched off in Supabase Auth.
ALLOWED_EMAILS=
# Optional: engine answers + judgments per account per rolling 24 hours
# (default 300). The backstop against a runaway loop or a stranger.
DAILY_UNIT_CAP=
# Optional: restrict which judge models a brand may pick in Settings
# (comma-separated model ids). Default: every model in MODEL_REGISTRY.
# Anything outside the list falls back to JUDGE_MODEL.
JUDGE_MODELS_ALLOWED=
# Optional: JUDGE_ENABLED=false switches sentiment analysis off for every
# brand on this deployment, whatever each brand's own Settings say. Engines
# still charge for their answers; the extract layer (mentions, position,
# share of voice, citations; text matching, no model call) still runs.
JUDGE_ENABLED=

# ---- Scheduled runs ---------------------------------------------------------
# Gates the `sweep` action, which pg_cron calls with no user session. At least
# 32 random characters (`openssl rand -hex 32`); the SAME value goes in the
# Vault row `prompt_tracker_sweep_secret`. The value below is for the LOCAL
# stack only (it matches seed.sql) and a hosted function refuses it.
SWEEP_SECRET=local-dev-sweep-secret-not-for-production-0000
