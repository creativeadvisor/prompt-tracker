# The app's connection to Supabase. Both values are public by design: the
# publishable (anon) key only ever reaches the database through Row Level
# Security. Real secrets (engine and judge API keys) live ONLY in
# supabase/functions/.env locally and in the Edge Function secrets in
# production — never here.
#
# Local stack (printed by `supabase start`):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
#
# Hosted project: Project Settings → API in the Supabase dashboard.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
