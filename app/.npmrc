# Supply-chain hardening
# Block install-time lifecycle scripts. If a package needs its build step,
# approve it explicitly: npm rebuild <package>
ignore-scripts=true
# npm 10 has no "minimum release age" option. To avoid installing a version
# published in the last few days, install with a cutoff date instead:
#   npm ci --before="$(date -v-3d +%Y-%m-%d)"   (macOS)  /  --before=YYYY-MM-DD
